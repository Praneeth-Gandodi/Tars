# TARS configuration — copy this file to `.env` and fill in your values.
# Get a free Groq API key from https://console.groq.com/keys
groq_api=your_groq_api_key_here

# Model identifier to use with Groq (list of models: https://console.groq.com/docs/models)
# Default: openai/gpt-oss-120b
model=openai/gpt-oss-120b